# ═══════════════════════════════════════════════
#  الأمانة للتمويل — متغيرات البيئة (OAuth 2.0)
#  انسخ إلى .env.local واملأ القيم الفعلية
#  تم الترحيل من Service Account إلى OAuth 2.0 (personal Drive, no quota issue)
# ═══════════════════════════════════════════════

# ── Google OAuth 2.0 (Personal Drive - No Quota Issue) ───
# احصل عليها من: https://console.cloud.google.com > APIs & Services > Credentials > OAuth 2.0 Client ID
GOOGLE_OAUTH_CLIENT_ID=1234567890-abc123def456.apps.googleusercontent.com
GOOGLE_OAUTH_CLIENT_SECRET=GOCSPX-abc123def456ghi789jkl

# Refresh Token - احصل عليه عبر:
# 1. https://developers.google.com/oauthplayground (مع Use your own OAuth credentials)
# 2. أو عبر /api/auth/google في موقعك ثم /api/auth/callback
# يجب أن يبدأ بـ 1//...
GOOGLE_OAUTH_REFRESH_TOKEN=1//04abc123def456ghi789jklmno...

# Redirect URI - يجب أن يكون مطابق تماماً لما في Google Cloud Console
# للـ Playground: https://developers.google.com/oauthplayground
# لموقعك: https://your-site.netlify.app/api/auth/callback
GOOGLE_OAUTH_REDIRECT_URI=https://developers.google.com/oauthplayground

# ── Google Sheets ──────────────────────────────
# معرف الشيت من الرابط: https://docs.google.com/spreadsheets/d/{THIS_PART}/edit
GOOGLE_SHEET_ID=1B2n3AbC...

# ── Google Drive (اختياري) ─────────────────────
# معرف مجلد الوالدين في Drive الخاص بك (من رابط: https://drive.google.com/drive/folders/{ID})
# إذا تركته فارغاً، سيتم إنشاء المجلدات في جذر Drive الخاص بك
GOOGLE_DRIVE_PARENT_FOLDER_ID=1X2y3Z...

# ── بيانات المدير (لوحة التحكم) ─────────────────
ADMIN_USERNAME=admin
ADMIN_PASSWORD=YourStrongPassword2024!
ADMIN_SESSION_SECRET=random-string-at-least-32-chars-change-me-now-pls

# ── SMTP (إشعارات البريد) ──────────────────────
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=your-email@gmail.com
SMTP_PASS=your-app-password
SMTP_FROM=noreply@yourdomain.com

# ── SMS (عراقي) ────────────────────────────────
SMS_PROVIDER=zaincash
SMS_API_KEY=your-api-key
SMS_SENDER_ID=AlAmanah

# ── ملاحظة: Service Account لم يعد مستخدم (تم الترحيل إلى OAuth) ──
# GOOGLE_SERVICE_ACCOUNT_KEY لم يعد مطلوب - احذفه
# GOOGLE_SERVICE_ACCOUNT_KEY_PATH لم يعد مطلوب
